{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuixiChat",
  "version": "0.0.1",
  "identifier": "ai.quixi.chat",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuixiChat",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Fast, private Gemma 4 chat on your Mac",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
