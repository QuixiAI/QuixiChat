{
  "name": "quixi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node packages/documents/tooling/pdfjs-range-patch.mjs",
    "dev": "npm run dev --workspace @quixi/web",
    "dev:desktop": "npm run tauri --workspace @quixi/desktop -- dev",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:core": "npm run typecheck --workspace @quixi/core && npm run typecheck:tests --workspace @quixi/core && npm test --workspace @quixi/core",
    "test:storage:blobs": "tsc --noEmit -p packages/storage/tsconfig.tests.json && node packages/storage/tests/browser/run.mjs",
    "test:storage:client": "tsc --noEmit -p packages/storage/tsconfig.tests.json && node packages/storage/tests/browser/run-archive.mjs",
    "test:storage:canonical": "tsc --noEmit -p packages/storage/tests/canonical/tsconfig.json && node --experimental-transform-types --test packages/storage/tests/canonical/*.test.ts",
    "test:host:web": "tsc --noEmit -p apps/web/tests/tsconfig.json && playwright test --config apps/web/tests/playwright.config.ts",
    "test:relay": "npm test --workspace @quixi/relay",
    "test:relay:browser": "npm run test:browser --workspace @quixi/relay",
    "build": "npm run build --workspace @quixi/web && npm run build --workspace @quixi/desktop && npm run build --workspace @quixi/extension",
    "build:desktop": "npm run tauri --workspace @quixi/desktop -- build",
    "check": "npm run sqlite:verify && npm run typecheck && npm run build",
    "check:desktop": "npm run sqlite:verify && npm run build --workspace @quixi/desktop && cargo check --locked --workspace",
    "sqlite:build": "python3 packages/storage/sqlite/build.py",
    "sqlite:verify": "node packages/storage/sqlite/verify.mjs",
    "test:e2e": "npm run sqlite:verify && npm run typecheck:tests && npm run build --workspace @quixi/web && playwright test",
    "test:search": "npm run typecheck:tests --workspace @quixi/search && npm test --workspace @quixi/search",
    "test:providers": "npm test --workspace @quixi/providers",
    "test:providers:browser": "npm run test:browser --workspace @quixi/providers",
    "test:importers": "npm run typecheck --workspace @quixi/importers && npm run typecheck:tests --workspace @quixi/importers && npm test --workspace @quixi/importers",
    "test:importers:browser": "npm run typecheck:tests --workspace @quixi/importers && node packages/importers/tests/browser/run.mjs",
    "test:app:browser": "tsc --noEmit -p packages/app/tsconfig.tests.json && node packages/app/tests/browser/run.mjs",
    "test:app:library": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/library-refresh.test.ts",
    "test:app:scale:browser": "tsc --noEmit -p packages/app/tsconfig.tests.json && node packages/app/tests/browser/scale.mjs",
    "test:app:providers": "node --experimental-transform-types --test packages/app/src/features/providers/tests/*.test.mjs",
    "test:app:startup": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/startup/*.test.ts",
    "test:app:switching": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/switching/*.test.ts",
    "test:app:preferences": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/preferences/*.test.ts",
    "test:app:attachments": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/attachments/*.test.ts",
    "test:app:health": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/providers/*.test.ts",
    "test:app:providers:browser": "node packages/app/src/features/providers/tests/browser/run.mjs",
    "test:app:imports:browser": "node packages/app/src/features/imports/tests/browser/run.mjs",
    "test:app:content": "node --experimental-transform-types --test packages/app/src/features/content/tests/*.test.mjs",
    "test:app:search-navigation": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/content/conversation-search.test.ts",
    "test:app:search-navigation:browser": "tsc --noEmit -p packages/app/src/features/content/tests/search-browser/tsconfig.json && node packages/app/src/features/content/tests/search-browser/run.mjs",
    "test:app:content:browser": "node --experimental-transform-types packages/app/src/features/content/tests/browser/run.mjs",
    "test:storage:archives": "tsc --noEmit -p packages/storage/tests/archives/tsconfig.json && node --experimental-transform-types --test packages/storage/tests/archives/*.test.ts && node --experimental-transform-types packages/storage/tests/archives/browser-proof.ts",
    "test:storage:selection": "node --experimental-transform-types packages/storage/tests/selection/run.mjs",
    "test:storage:schema8": "tsc --noEmit -p packages/storage/tests/selection/schema8/tsconfig.json && node packages/storage/tests/selection/schema8/run.mjs",
    "test:documents": "npm test --workspace @quixi/documents",
    "test:documents:layout": "tsc --noEmit -p packages/documents/tests/tsconfig.layout.json && node --experimental-transform-types --test packages/documents/tests/layout.test.ts",
    "test:documents:layout:browser": "tsc --noEmit -p packages/documents/tests/layout-browser/tsconfig.json && node packages/documents/tests/layout-browser/run.mjs",
    "test:storage:protocol": "node packages/storage/tests/protocol/run.mjs",
    "test:storage:managed-selection": "tsc --noEmit -p packages/storage/tests/selection/managed/tsconfig.json && node packages/storage/tests/selection/managed/run.mjs",
    "test:storage:activation": "tsc --noEmit -p packages/storage/tests/selection/integration/tsconfig.json && node packages/storage/tests/selection/integration/run.mjs",
    "test:storage:retained": "node packages/storage/tests/retained/run.mjs",
    "test:storage:extraction": "tsc --noEmit -p packages/storage/tests/extraction/tsconfig.json && node packages/storage/tests/extraction/run.mjs",
    "test:storage:extraction-layout": "tsc --noEmit -p packages/storage/tests/extraction-layout/tsconfig.json && node packages/storage/tests/extraction-layout/run.mjs",
    "test:storage:extraction-digests": "tsc --noEmit -p packages/storage/tests/extraction-performance/tsconfig.json && node packages/storage/tests/extraction-performance/run.mjs",
    "test:app:archives": "node --experimental-transform-types --test packages/app/src/features/archives/tests/*-controller.test.mjs",
    "test:storage:reconcile-retained": "node packages/storage/tests/selection/integration/reconcile.mjs",
    "test:app:archives:browser": "tsc --noEmit -p packages/app/src/features/archives/tests/browser/tsconfig.json && node packages/app/src/features/archives/tests/browser/run.mjs",
    "test:storage:operation-claims": "tsc --noEmit -p packages/storage/tests/operation-claims/tsconfig.json && node packages/storage/tests/operation-claims/run.mjs",
    "test:storage:extraction-search": "tsc --noEmit -p packages/storage/tests/extraction-search/tsconfig.json && node packages/storage/tests/extraction-search/run.mjs",
    "test:storage:extraction:browser": "tsc --noEmit -p packages/storage/tests/extraction-browser/tsconfig.json && node packages/storage/tests/extraction-browser/run.mjs",
    "test:documents:storage": "tsc --noEmit -p packages/documents/tests/tsconfig.unit.json && node --experimental-transform-types --test packages/documents/tests/storage-source.test.ts",
    "test:documents:persistence:browser": "tsc --noEmit -p packages/documents/tests/persistence-browser/tsconfig.json && node packages/documents/tests/persistence-browser/run.mjs",
    "test:storage:search-navigation": "tsc --noEmit -p packages/storage/tests/search-navigation/tsconfig.json && node packages/storage/tests/search-navigation/run.mjs",
    "test:app:documents": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/documents/*.test.ts",
    "test:documents:mutation": "tsc --noEmit -p packages/documents/tests/tsconfig.persist-mutation.json && node --experimental-transform-types --test packages/documents/tests/persist-mutation.test.ts",
    "test:documents:clear": "tsc --noEmit -p packages/documents/tests/tsconfig.clear.json && node --experimental-transform-types --test packages/documents/tests/clear.test.ts",
    "test:storage:retained-extraction": "node packages/storage/tests/retained-extraction/run.mjs",
    "perf:documents": "tsc --noEmit -p perf/documents/tsconfig.json && node perf/documents/run.mjs",
    "test:app:documents:browser": "tsc --noEmit -p packages/app/src/features/documents/tests/browser/tsconfig.json && node packages/app/src/features/documents/tests/browser/run.mjs",
    "test:app:summaries": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/compaction/*.test.ts",
    "test:host:regional": "tsc --noEmit -p apps/web/tests/tsconfig.json && node --experimental-transform-types --test apps/web/tests/regional-*.test.ts",
    "test:app:relay:browser": "tsc --noEmit -p packages/app/tsconfig.tests.json && node packages/app/tests/browser/relay/run.mjs",
    "test:app:regional:native": "python3 tests/hosts/regional-app-proof/run.py",
    "test:host:oauth:native": "python3 tests/hosts/oauth-proof/run.py",
    "test:host:oauth:web": "tsc --noEmit -p apps/web/tests/tsconfig.json && node --experimental-transform-types --test apps/web/tests/oauth-unit.test.ts && node apps/web/tests/oauth-run.mjs",
    "test:storage:blob-inventory": "tsc --noEmit -p packages/storage/tests/blob-inventory/tsconfig.json && node packages/storage/tests/blob-inventory/run.mjs",
    "test:app:storage-health": "tsc --noEmit -p packages/app/tsconfig.tests.json && node --experimental-transform-types --test packages/app/tests/diagnostics/*.test.ts",
    "test:app:storage-health:browser": "tsc --noEmit -p packages/app/tests/browser/diagnostics/tsconfig.json && node packages/app/tests/browser/diagnostics/run.mjs",
    "test:app:semantic:browser": "tsc --noEmit -p packages/app/tsconfig.tests.json && node packages/app/tests/browser/semantic-run.mjs",
    "build:extension": "npm run build --workspace @quixi/extension",
    "test:extension": "npm run typecheck --workspace @quixi/extension && npm test --workspace @quixi/extension",
    "test:extension:e2e": "npm run test:e2e --workspace @quixi/extension"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
