{
  "name": "@quixi/quixi-embed",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Independent model-specialized embedding runtime.",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/index.ts",
    "./tokenizer": "./src/tokenizer.ts",
    "./chunking": "./src/chunking.ts",
    "./service": "./src/service/index.ts",
    "./kernels/*": "./kernels/webgpu/1.0.0/*",
    "./artifacts/*": "./artifacts/*"
  },
  "scripts": {
    "build:native": "python3 native/build.py --target native",
    "build:native:diagnostic": "python3 native/build.py --target native --diagnostic",
    "build:wasm": "python3 native/build.py --target wasm",
    "build:wasm:diagnostic": "python3 native/build.py --target wasm --diagnostic",
    "compile:model": "build/reference-env/bin/python compiler/compile_model.py",
    "test:reference": "build/reference-env/bin/python -m unittest discover -s reference -p \"test_*.py\"",
    "test:wasm-api": "node --experimental-strip-types tests/scalar-api.mjs",
    "test:native": "build/reference-env/bin/python -m unittest discover -s tests -p \"test_native.py\"",
    "test:browsers": "node tests/browser-check.mjs",
    "build:wasm:simd": "python3 native/build.py --target wasm --simd",
    "build:wasm:simd:diagnostic": "python3 native/build.py --target wasm --simd --diagnostic",
    "test:simd:kernels": "python3 native/check_kernels.py",
    "test:simd:api": "node --experimental-strip-types tests/scalar-api.mjs simd",
    "test:simd:browsers": "node tests/browser-check.mjs simd",
    "bench:cpu": "node --experimental-strip-types perf/run.mjs",
    "bench:cpu:browsers": "node perf/browser.mjs all",
    "test:simd:allocator": "python3 native/check_memory.py",
    "test:simd:memory": "node --expose-gc --experimental-strip-types tests/cpu-memory.mjs",
    "test:gpu:identity": "python3 native/gpu_release.py",
    "test:gpu:types": "tsc -p tsconfig.gpu.json",
    "test:gpu:tuning": "node --experimental-strip-types tests/gpu-tuning.mjs",
    "test:gpu": "python3 native/gpu_ci.py",
    "test:gpu:full": "python3 native/gpu_ci.py --full",
    "bench:gpu": "node perf/gpu-browser.mjs",
    "bench:gpu:check": "python3 perf/check_gpu.py",
    "test:scheduler:unit": "node --experimental-strip-types --test tests/scheduler.mjs",
    "test:self-test:unit": "node --experimental-strip-types --test tests/self-test.mjs",
    "test:scheduler": "python3 native/scheduler_ci.py",
    "test:scheduler:gpu": "python3 native/scheduler_ci.py --gpu",
    "test:token-preflight": "node --experimental-strip-types tests/token-preflight.mjs",
    "test:offsets": "python3 native/offset_ci.py",
    "test:offsets:api": "node --experimental-strip-types tests/token-offsets.mjs",
    "test:offsets:native": "build/reference-env/bin/python reference/check_offsets_native.py"
  }
}
